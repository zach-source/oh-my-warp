+/// The gRPC harness-host endpoint of the selected backend, if it defines one.
+/// Used by the in-process agent bridge to decide whether to route agent ops to a
+/// custom harness host. `None` for the built-in Warp backend or any backend
+/// without a `grpc_endpoint`.
+pub fn selected_grpc_endpoint() -> Option<String> {
+    load()
+        .selected_backend()
+        .map(|b| b.grpc_endpoint.clone())
+        .filter(|e| !e.is_empty())
+}
