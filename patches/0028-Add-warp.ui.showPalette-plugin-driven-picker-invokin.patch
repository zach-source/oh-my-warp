+    // `showPalette(title, items)` — `items` is `[{ label, onSelect }]`. Each `onSelect` is
+    // registered in the host; the app shows a picker and, on selection, invokes the chosen item's
+    // callback via `CallJsFunctionService`. See PLUGIN_SPEC.md (M4).
+    ui.set(
+        "showPalette",
+        Function::new(
+            ctx,
+            MutFn::from(move |title: String, items: Vec<Object<'js>>| {
+                let mut plugin = plugin.get_mut();
+                let palette_items: Vec<PalettePluginItem> = items
+                    .into_iter()
+                    .filter_map(|item| {
+                        let label: String = item.get("label").ok()?;
+                        let on_select = item.get::<_, Function>("onSelect").ok()?;
+                        let func_ref = plugin
+                            .js_function_registry_mut()
+                            .register_js_function::<String, OptionalToast>(on_select, ctx);
+                        Some(PalettePluginItem {
+                            label,
+                            function_id: func_ref.id,
+                        })
+                    })
+                    .collect();
+                super::app_request::send_app_request(PluginAppRequest::ShowPalette {
+                    title,
+                    items: palette_items,
+                });
+            }),
+        ),
+    )?;
     Ok(ui)
 }
 
