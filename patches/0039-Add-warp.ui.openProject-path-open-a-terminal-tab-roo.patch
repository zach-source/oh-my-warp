From ff390b2394ea084219c37e574782c86c4e8fd127 Mon Sep 17 00:00:00 2001
From: Zach Taylor <zctaylor.work@gmail.com>
Date: Mon, 25 May 2026 14:07:04 -0400
Subject: [PATCH 39/39] Add warp.ui.openProject(path): open a terminal tab
 rooted at a directory (oh-my-warp)

---
 app/src/plugin/app/mod.rs                |  5 +++++
 app/src/plugin/app_requests.rs           |  2 ++
 app/src/plugin/host/native/js_api/mod.rs | 11 ++++++++++-
 app/src/workspace/view.rs                |  5 +++++
 4 files changed, 22 insertions(+), 1 deletion(-)

diff --git a/app/src/plugin/app/mod.rs b/app/src/plugin/app/mod.rs
index f6e22d7e..0e8d2279 100644
--- a/app/src/plugin/app/mod.rs
+++ b/app/src/plugin/app/mod.rs
@@ -179,6 +179,9 @@ impl PluginHost {
             PluginAppRequest::OpenWebTab { url } => {
                 ctx.emit(PluginHostEvent::OpenWebTab { url });
             }
+            PluginAppRequest::OpenProject { path } => {
+                ctx.emit(PluginHostEvent::OpenProject { path });
+            }
         }
     }
 }
@@ -196,6 +199,8 @@ pub enum PluginHostEvent {
     },
     /// Open an embedded browser pane navigated to `url` (`warp.ui.openWebTab`).
     OpenWebTab { url: String },
+    /// Open a new tab with a terminal rooted at `path` (`warp.ui.openProject`).
+    OpenProject { path: String },
 }
 
 impl Drop for PluginHost {
diff --git a/app/src/plugin/app_requests.rs b/app/src/plugin/app_requests.rs
index 01a6446d..03dfb816 100644
--- a/app/src/plugin/app_requests.rs
+++ b/app/src/plugin/app_requests.rs
@@ -50,6 +50,8 @@ pub enum PluginAppRequest {
     },
     /// Open an embedded browser pane navigated to `url` (`warp.ui.openWebTab`).
     OpenWebTab { url: String },
+    /// Open a new tab with a terminal rooted at `path` (`warp.ui.openProject`).
+    OpenProject { path: String },
 }
 
 static SENDER: OnceLock<Sender<PluginAppRequest>> = OnceLock::new();
diff --git a/app/src/plugin/host/native/js_api/mod.rs b/app/src/plugin/host/native/js_api/mod.rs
index 2401a85a..da6181b7 100644
--- a/app/src/plugin/host/native/js_api/mod.rs
+++ b/app/src/plugin/host/native/js_api/mod.rs
@@ -254,7 +254,8 @@ fn network_api<'js>(ctx: Ctx<'js>) -> rquickjs::Result<Object<'js>> {
 /// Returns a JS object representing the UI namespace for the Warp Plugin API.
 ///
 /// `toast(message, kind?)` — transient toast; `showMarkdown(title, markdown)` — markdown panel;
-/// `showPalette(title, items)` — command picker; `openWebTab(url)` — open an embedded browser pane.
+/// `showPalette(title, items)` — command picker; `openWebTab(url)` — open an embedded browser pane;
+/// `openProject(path)` — open a new tab with a terminal rooted at `path`.
 ///
 /// Each request is enqueued (non-blocking) and relayed to the app on a background task; we must not
 /// do the blocking IPC inline on the plugin runner thread (see `super::app_request`).
@@ -309,6 +310,14 @@ fn ui<'js>(ctx: Ctx<'js>) -> rquickjs::Result<Object<'js>> {
             super::app_request::send_app_request(PluginAppRequest::OpenWebTab { url });
         }),
     )?;
+    // `openProject(path)` — opens a new tab with a terminal rooted at `path` (the tmux-sessionizer
+    // workflow). Fire-and-forget.
+    ui.set(
+        "openProject",
+        Function::new(ctx, |path: String| {
+            super::app_request::send_app_request(PluginAppRequest::OpenProject { path });
+        }),
+    )?;
     Ok(ui)
 }
 
diff --git a/app/src/workspace/view.rs b/app/src/workspace/view.rs
index eaf3d632..fa93e938 100644
--- a/app/src/workspace/view.rs
+++ b/app/src/workspace/view.rs
@@ -2036,6 +2036,11 @@ impl Workspace {
                 // `BrowserView::new` via the one-shot URL override.
                 me.open_web_tab(Some(url.clone()), ctx);
             }
+            crate::plugin::PluginHostEvent::OpenProject { path } => {
+                // Open a new tab with a terminal rooted at `path` (backs the
+                // sessionizer plugin). Same path as `WorkspaceAction::OpenRepository`.
+                me.open_repository(Some(path), ctx);
+            }
         });
     }
 
