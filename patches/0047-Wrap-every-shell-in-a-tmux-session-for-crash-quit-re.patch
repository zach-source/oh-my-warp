Subject: [PATCH 47/47] Wrap every shell in a tmux session for crash/quit
 recovery (oh-my-warp)

---
 app/src/terminal/local_tty/unix.rs | 90 ++++++++++++++++++++++++++++--
 1 file changed, 86 insertions(+), 4 deletions(-)

diff --git a/app/src/terminal/local_tty/unix.rs b/app/src/terminal/local_tty/unix.rs
index c20b0f17..ea4c2481 100644
--- a/app/src/terminal/local_tty/unix.rs
+++ b/app/src/terminal/local_tty/unix.rs
@@ -23,6 +23,7 @@ use serde::{Deserialize, Serialize};
 use signal_hook_mio::v1_0::Signals;
 use warp_core::channel::ChannelState;
 use warp_core::features::FeatureFlag;
+use warp_core::SessionId;
 use warpui::{AppContext, SingletonEntity};
 
 use super::event_loop::{PTY_TOKEN, SIGNALS_TOKEN};
@@ -217,6 +218,70 @@ pub(super) fn spawn(options: PtyOptions) -> Result<PtySpawnInfo> {
 /// environment variables, and startup directory.
 ///
 /// Does not perform any PTY-level setup; hand the returned `Command`
+/// oh-my-warp: wrap the shell invocation in a tmux session so that running
+/// processes survive a Warp crash/quit and can be recovered. Controlled by the
+/// `OMW_TMUX` env var (enabled by default; set `OMW_TMUX=0` to disable). Returns
+/// `Some((program, args))` to spawn in place of the shell, or `None` to spawn the
+/// shell directly (tmux disabled, or the `tmux` binary is not installed).
+///
+/// On crash/quit the tmux *server* (a separate daemon) keeps the session alive.
+/// When a new Warp pane spawns it reattaches the first un-attached `warp-*`
+/// session if one exists (recovering that work), otherwise it creates a fresh
+/// uniquely-named session.
+///
+/// NOTE: running inside tmux means Warp sees tmux's screen rather than the
+/// shell's integration sequences, so Warp blocks / AI / autosuggestions are
+/// disabled for tmux-wrapped panes — this is the documented trade-off for full
+/// live-session recovery.
+fn omw_tmux_wrap(
+    shell_path: &Path,
+    shell_args: &[OsString],
+    session_id: SessionId,
+) -> Option<(PathBuf, Vec<OsString>)> {
+    let enabled = std::env::var("OMW_TMUX")
+        .map(|v| v != "0" && !v.eq_ignore_ascii_case("false"))
+        .unwrap_or(true);
+    if !enabled {
+        return None;
+    }
+
+    let tmux = crate::util::path::resolve_executable("tmux")?.into_owned();
+
+    // Reattach an orphaned `warp-*` session (recovering its processes) if one is
+    // free; otherwise create a fresh session keyed by this session's id.
+    let session = pick_orphaned_tmux_session(&tmux)
+        .unwrap_or_else(|| format!("warp-{}", session_id.as_u64()));
+
+    let mut args: Vec<OsString> = vec![
+        "new-session".into(),
+        // Attach if `session` already exists, otherwise create it.
+        "-A".into(),
+        "-s".into(),
+        session.into(),
+        // The command run as the session's first process when newly created.
+        shell_path.as_os_str().to_owned(),
+    ];
+    args.extend(shell_args.iter().cloned());
+    Some((tmux, args))
+}
+
+/// oh-my-warp: returns the name of the first existing `warp-*` tmux session that
+/// currently has no client attached (a candidate to recover), if any.
+fn pick_orphaned_tmux_session(tmux: &Path) -> Option<String> {
+    let output = Command::new(tmux)
+        .args(["list-sessions", "-F", "#{session_name}:#{session_attached}"])
+        .output()
+        .ok()?;
+    if !output.status.success() {
+        return None;
+    }
+    String::from_utf8_lossy(&output.stdout)
+        .lines()
+        .filter_map(|line| line.rsplit_once(':'))
+        .find(|(name, attached)| name.starts_with("warp-") && attached.trim() == "0")
+        .map(|(name, _)| name.to_string())
+}
+
 /// to [`spawn_command_in_pty`].
 #[allow(clippy::too_many_arguments)]
 fn build_host_shell_command(
@@ -237,10 +302,27 @@ fn build_host_shell_command(
         shell_starter.logical_shell_path().display()
     );
 
-    let mut builder = Command::new(shell_starter.logical_shell_path());
-    for arg in shell_starter.args() {
-        builder.arg(arg);
-    }
+    // oh-my-warp: optionally wrap the shell in a tmux session for crash/quit
+    // recovery (see `omw_tmux_wrap`). When wrapping, tmux becomes the spawned
+    // program and the shell + its args become the session's command.
+    let mut builder = match omw_tmux_wrap(
+        shell_starter.logical_shell_path(),
+        shell_starter.args(),
+        shell_starter.session_id(),
+    ) {
+        Some((program, tmux_args)) => {
+            let mut builder = Command::new(program);
+            builder.args(tmux_args);
+            builder
+        }
+        None => {
+            let mut builder = Command::new(shell_starter.logical_shell_path());
+            for arg in shell_starter.args() {
+                builder.arg(arg);
+            }
+            builder
+        }
+    };
 
